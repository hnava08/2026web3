@page
@model RestauranteCategoriasPlatos.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<h1>Lista de categorías</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Registrar categoría</a>
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Cantidad de platos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model.Categorias)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nombre</td>
                <td>@(categoria.Descripcion ?? "—")</td>
                <td>@categoria.Platos.Count</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Categorias.Any())
{
    <p class="text-muted">No hay categorías registradas. Registre una categoría para comenzar.</p>
}
