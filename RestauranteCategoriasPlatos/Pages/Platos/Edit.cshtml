@page "{id:int}"
@model RestauranteCategoriasPlatos.Pages.Platos.EditModel
@{
    ViewData["Title"] = "Editar plato";
}

<h1>Editar plato</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Plato.Id" />

            <div class="mb-3">
                <label asp-for="Plato.Nombre" class="form-label"></label>
                <input asp-for="Plato.Nombre" class="form-control" />
                <span asp-validation-for="Plato.Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Plato.Descripcion" class="form-label"></label>
                <textarea asp-for="Plato.Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Plato.Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Plato.Precio" class="form-label"></label>
                <input asp-for="Plato.Precio" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Plato.Precio" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Plato.Disponible" class="form-check-input" />
                <label asp-for="Plato.Disponible" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label asp-for="Plato.CategoriaId" class="form-label"></label>
                <select asp-for="Plato.CategoriaId" asp-items="Model.Categorias" class="form-select">
                    <option value="">-- Seleccione una categoría --</option>
                </select>
                <span asp-validation-for="Plato.CategoriaId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
