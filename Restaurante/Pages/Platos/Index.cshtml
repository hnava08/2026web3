@page
@model Restaurante.Pages.Platos.IndexModel
@{
    ViewData["Title"] = "Platos";
}

<h1>Platos</h1>
<p><a asp-page="Create">Registrar plato</a></p>

<table>
    <tr>
        <th>Nombre</th>
        <th>Categoria</th>
        <th>Precio</th>
        <th>Disponible</th>
        <th>Acciones</th>
    </tr>
    @foreach (var item in Model.Platos)
    {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Categoria.Nombre</td>
            <td>@item.Precio</td>
            <td>@(item.Disponible ? "Si" : "No")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@item.Id">Editar</a>
                <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" style="display:inline">
                    <button type="submit">Eliminar</button>
                </form>
            </td>
        </tr>
    }
</table>
