@page
@model Restaurante.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorias";
}

<h1>Categorias</h1>
<p><a asp-page="Create">Registrar categoria</a></p>

<table>
    <tr>
        <th>Id</th>
        <th>Nombre</th>
        <th>Descripcion</th>
    </tr>
    @foreach (var item in Model.Categorias)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
        </tr>
    }
</table>
