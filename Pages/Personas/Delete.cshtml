@page "{id:int}"
@model _2026web3.Pages.Personas.DeleteModel
@{
    ViewData["Title"] = "Eliminar persona";
}

<h1>Eliminar persona</h1>

<div class="alert alert-danger">
    ¿Está seguro de que desea eliminar esta persona? También se eliminarán su pasaporte y sus inscripciones.
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Persona.Name</dd>

    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.Persona.dob.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">País</dt>
    <dd class="col-sm-9">@Model.Persona.Pais?.Name</dd>

    <dt class="col-sm-3">Pasaporte</dt>
    <dd class="col-sm-9">
        @if (Model.Persona.Pasaporte is null)
        {
            <span class="text-muted">Sin pasaporte</span>
        }
        else
        {
            @Model.Persona.Pasaporte.Numero
        }
    </dd>

    <dt class="col-sm-3">Materias</dt>
    <dd class="col-sm-9">
        @if (Model.Persona.Materias.Count == 0)
        {
            <span class="text-muted">Ninguna</span>
        }
        else
        {
            @string.Join(", ", Model.Persona.Materias.OrderBy(m => m.Name).Select(m => m.Name))
        }
    </dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Persona.Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>
