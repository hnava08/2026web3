@page
@model BibliotecaAutoresLibros.Pages.Autores.IndexModel
@{
    ViewData["Title"] = "Autores";
}

<h1>Lista de autores</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Registrar autor</a>
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre completo</th>
            <th>Nacionalidad</th>
            <th>Cantidad de libros</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model.Autores)
        {
            <tr>
                <td>@autor.Id</td>
                <td>@autor.NombreCompleto</td>
                <td>@(autor.Nacionalidad ?? "—")</td>
                <td>@autor.Libros.Count</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Autores.Any())
{
    <p class="text-muted">No hay autores registrados. Registre un autor para comenzar.</p>
}
