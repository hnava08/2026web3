@page
@model BibliotecaAutoresLibros.Pages.Libros.IndexModel
@{
    ViewData["Title"] = "Libros";
}

<h1>Lista de libros</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Registrar libro</a>
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Título</th>
            <th>Año de publicación</th>
            <th>Disponibilidad</th>
            <th>Autor</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model.Libros)
        {
            <tr>
                <td>@libro.Titulo</td>
                <td>@libro.AnioPublicacion</td>
                <td>@(libro.Disponibilidad ? "Disponible" : "No disponible")</td>
                <td>@libro.Autor?.NombreCompleto</td>
                <td class="d-flex gap-2">
                    <a asp-page="Edit" asp-route-id="@libro.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@libro.Id">
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('¿Eliminar este libro?');">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Libros.Any())
{
    <p class="text-muted">No hay libros registrados.</p>
}
